table user {

id int pk
role enum('admin','doctor','patient')
first_name varchar(50)
last_name varchar(50)
email varchar(100)
password varchar(50)
created_at timestamp
}
ref: patients.user_id > user.id
ref: doctors.user_id > user.id



table departments {

id int
department_name varchar
loacotion varchar
created_at timestamp
}



table patients {

id int 
adress text 
phone varchar
date_of_birth date
created_at timestamp
updated_at timestamp
user_id int
}

table doctors {

id int 
specialisation varchar
phone varchar
department_id int
created_at timestamp
updated_at timestamp
user_id int

}
ref: doctors.department_id > departments.id


table  Medications {

id int
name varchar(255)
instruction text
created_at timestamp

}

table Prescription {

id int 
date date 
doctor_id int 
patient_id int 
Medication_id int
dosage_instructions text
created_at timestamp
}

ref: Prescription.Medication_id >Medications.id
ref: Prescription.doctor_id > doctors.id
ref: Prescription.patient_id > patients.id


table Appointment {

id int
date date
time time
doctor_id int 
patient_id int
reason text
ststus enum(scheduled, done, cancelled)
created_at timestamp
updated_at timestamp


}
ref: Appointment.doctor_id > doctors.id
ref: Appointment.patient_id > patients.id


